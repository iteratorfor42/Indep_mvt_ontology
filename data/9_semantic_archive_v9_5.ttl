# ---- Claim (Core 34 + Hold 5 = 39) ----

claim:CLM-OSAN-01 a prov:Claim ;
    prov:belongsToItem item:item-1 ;
    prov:claimDecision "core" ;
    prov:hasSubject ent:이승훈 ;
    prov:hasObject ent:오산학교 ;
    prov:hasRelation "설립" ;
    prov:claimText "이승훈이 오산학교를 설립하였다."@ko ;
    prov:dateValue "1907-12"^^xsd:gYearMonth ;
    prov:datePrecision vocab:Month ;
    prov:dateValueStatus vocab:source_stated ;
    prov:hasEstimation "false"^^xsd:boolean ;
    prov:hasClaimStatus vocab:confirmed ;
    prov:hasDateStatus vocab:verified ;
    prov:hasVerificationStatus vocab:directly_verified ;
    prov:hasReviewFlag vocab:none ;
    prov:hasSource src:SRC-101 ;
    prov:hasEvidence evd:EVD-101 ;
    prov:changeHistory "v9.1 pre-TTL cleanup; provenance retained | v9.3: 유지 — review_flag=relationship_issue가 있으나 claim_status=confirmed는 그대로 근거가 충분함을 의미하므로 Core에 유지(review_flag와 claim_status는 독립축, Rule G-05). CLM-OSAN-02(개교)만 보류로 분리" ;
    prov:verificationDate "2026-08-29"^^xsd:date .

claim:CLM-002 a prov:Claim ;
    prov:belongsToItem item:item-2 ;
    prov:claimDecision "core" ;
    prov:hasSubject ent:안창호 ;
    prov:hasObject ent:대성학교 ;
    prov:hasRelation "설립" ;
    prov:claimText "안창호가 평양에 대성학교를 설립하였다."@ko ;
    prov:hasEstimation "false"^^xsd:boolean ;
    prov:hasClaimStatus vocab:confirmed ;
    prov:hasDateStatus vocab:not_directly_verified ;
    prov:hasVerificationStatus vocab:directly_verified ;
    prov:hasReviewFlag vocab:none ;
    prov:hasSource src:SRC-002 ;
    prov:hasEvidence evd:EVD-002 ;
    prov:changeHistory "v9.1 pre-TTL cleanup; retained with direct source/evidence | v9.3: 유지 — 대성학교 설립 관련 중복 가능 Claim(CLM-002/CLM-011)으로 식별됨. 지금 병합하면 개별 Evidence를 잃으므로, 두 Claim과 Evidence를 각각 보존한 채 '동일 Claim+복수 Evidence' 통합 여부는 후속 provenance 정리 과제로 유보 | v9.5: date_status 공란→not_directly_verified 정합화. 대성학교 설립은 특정 시점에 일어난 사건이나, 정확한 날짜를 직접 확인하지 못함" ;
    prov:verificationDate "2026-08-29"^^xsd:date .

claim:CLM-003 a prov:Claim ;
